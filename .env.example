# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon key (public, read-only once rls.sql is applied)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase service-role key: server only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated emails allowed to use admin routes
ADMIN_EMAILS=admin1@example.com,admin2@example.com
ANTHROPIC_API_KEY=sk-ant-your-key                    # server only, scorecard parsing (preferred)
OPENAI_API_KEY=sk-your-key                          # server only; scorecard parsing
# SCORECARD_MODEL=claude-haiku-5-5                 # optional override; claude-* uses Anthropic, anything else OpenAI
